GEMINI_API_KEY=
GEMINI_MODEL=

# Backend del modelo: "apikey" (default, usa GEMINI_API_KEY de arriba) o
# "vertex" (Vertex AI, autentica por ADC -- `gcloud auth application-default
# login` -- sin API key). Con "vertex" hacen falta GOOGLE_CLOUD_PROJECT y
# GOOGLE_CLOUD_LOCATION; GEMINI_MODEL se usa igual en los dos modos.
MODEL_BACKEND=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Telegram (fase 2): TELEGRAM_BOT_TOKEN se saca de @BotFather.
# TELEGRAM_CHAT_ID es el unico chat autorizado a hablar con el bot (el de
# la dueña) -- se saca hablando con @userinfobot o @RawDataBot en Telegram,
# no hace falta el bot propio corriendo para conseguirlo. Cualquier otro
# chat que le escriba al bot recibe un aviso de no autorizado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Langfuse (tarea 1.19, opcional): sin LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY,
# el grafo funciona igual pero sin trazas. LANGFUSE_BASE_URL (o su alias
# LANGFUSE_HOST) cae al contenedor local (localhost:3000) si se deja vacia.
# Las claves se generan en la UI de Langfuse despues de levantar el
# contenedor (ver LANGFUSE.md).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
