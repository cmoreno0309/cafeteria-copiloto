# Secretos para docker-compose.langfuse.yml. Opcional: el compose ya trae
# defaults funcionales para uso local (no expuesto a internet). Copia este
# archivo a .env.langfuse (gitignored) solo si queres reemplazarlos.
#
# Generar valores:
#   openssl rand -hex 32   -> ENCRYPTION_KEY (tiene que ser hex de 32 bytes)
#   openssl rand -hex 16   -> el resto de los secretos

SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
